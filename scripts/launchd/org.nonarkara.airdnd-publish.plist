<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.nonarkara.airdnd-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/Data/AirDnD/deploy/airdnd-platform/scripts/publish_snapshot.sh</string>
  </array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Volumes/Data/AirDnD/logs/publish.log</string>
  <key>StandardErrorPath</key><string>/Volumes/Data/AirDnD/logs/publish.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key><string>postgresql://localhost:5432/airdnd</string>
    <key>MIN_DEPLOY_INTERVAL</key><string>600</string>
  </dict>
</dict>
</plist>
