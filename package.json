{
  "name": "air-dnd--dinner-and-date-",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "og:cards": "node scripts/generate_og_cards.js",
    "build": "npm run guard:no-supabase && npm run verify:snapshot -- --quiet && vite build",
    "build:full": "npm run snapshot:refresh && npm run feed:refresh && npm run photos:stage && npm run verify:snapshot && npm run places:build && npm run og:cards && npm run media:sync && npm run build",
    "photos:stage": "node scripts/stage_snapshot_photos.js",
    "places:build": "node scripts/build_place_photos.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "scrape": "node scripts/scraper.js",
    "scrape:live": "node scripts/telegram_scraper.js",
    "scrape:watch": "node scripts/telegram_scraper.js --watch",
    "backfill:local": "node --max-old-space-size=384 scripts/backfill_local.js",
    "repair:photos": "node scripts/repair_photo_urls.js",
    "verify:snapshot": "node scripts/verify_snapshot.js",
    "geo:index": "node scripts/build_geo_index.js",
    "snapshot:refresh": "node scripts/refresh_public_snapshot.js",
    "feed:refresh": "node scripts/refresh_feed_snapshot.js",
    "patterns:compute": "node scripts/compute_patterns.js",
    "audit:data": "node scripts/audit_public_data.js",
    "cleanup:companions": "node scripts/cleanup_public_companions.js",
    "visitors:sync": "node scripts/sync_visitor_logs.js",
    "test": "node --test",
    "bot": "node scripts/telegram_bot.js",
    "userbot": "node scripts/userbot.js",
    "userbot:daemon": "chmod +x scripts/daemon.sh && ./scripts/daemon.sh",
    "sociology:compute": "node scripts/compute_sociology.js",
    "research:compute": "node scripts/compute_research.js",
    "health:research": "node scripts/build_health_research.js",
    "verify:maps": "node scripts/gmaps_verify.js",
    "verify:maps:dry": "node scripts/gmaps_verify.js --dry-run",
    "start": "node server.js",
    "otop:fetch": "node scripts/otop/fetch.js",
    "otop:discover": "node scripts/otop/fetch.js --discover",
    "otop:standards": "node scripts/otop/standards.js",
    "otop:briefs": "node scripts/otop/briefs.js",
    "otop:intake": "node scripts/otop/intake_pipeline.js",
    "otop:build": "node scripts/otop/build.js && node scripts/otop/standards.js && node scripts/otop/revenue.js && node scripts/otop/insights.js && node scripts/otop/champions.js && node scripts/otop/anchors.js && node scripts/otop/graph.js && node scripts/otop/briefs.js && node scripts/otop/province-faces.js && node scripts/otop/datasets.js && node scripts/otop/softpower.js",
    "otop:datasets": "node scripts/otop/datasets.js",
    "otop:dev": "vite --config vite.otop.config.js",
    "otop:site": "vite build --config vite.otop.config.js",
    "otop:og": "node scripts/otop-og.mjs",
    "otop:prerender": "node scripts/otop-prerender.mjs",
    "otop:routes": "node scripts/otop-routes-check.mjs",
    "otop:gates": "bash scripts/otop/gates.sh",
    "otop:preserve": "node scripts/otop-preservation.mjs",
    "otop:msh": "node scripts/otop-msh-audit.mjs",
    "otop:all": "npm run otop:build && npm run otop:og && npm run otop:site && npm run otop:prerender",
    "otop:ship": "npm run otop:og && npm run otop:site && npm run otop:prerender && (cd dist-otop && npx wrangler pages deploy . --project-name otop --branch main) && npm run otop:verify",
    "otop:verify": "bash scripts/otop/verify-live.sh",
    "test:otop": "node --test test/otop_*.test.js",
    "otop:faces": "node scripts/otop/province-faces.js",
    "otop:media": "node scripts/otop/fetch-province-media.mjs",
    "otop:media:cache": "node scripts/otop/fetch-province-media.mjs --cache --categories",
    "guard:no-supabase": "node scripts/guard_no_supabase.js",
    "deploy": "npm run build && npm run guard:no-supabase -- --dist && npx wrangler pages deploy dist --project-name sabaisabai-airdnd --branch main",
    "media:sync": "node scripts/sync_media.js --prune-snapshots",
    "publish": "bash scripts/publish_snapshot.sh",
    "spatial:snapshot": "node scripts/otop-snapshot.mjs",
    "spatial:gate": "node scripts/spatial/spatial-check.mjs --dir design/spatial-snapshots --baseline design/spatial-baseline.json",
    "spatial:check": "node scripts/spatial/spatial-falsify.mjs design/spatial-snapshots",
    "otop:sweep": "node scripts/otop-route-sweep.mjs",
    "otop:holes": "node scripts/otop-empty-tracks.mjs",
    "otop:softpower": "node scripts/otop/softpower.js",
    "otop:softpower:fetch": "node scripts/otop/softpower.js --fetch",
    "otop:measure": "node scripts/otop-measure.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@supabase/supabase-js": "^2.108.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "googleapis": "^171.4.0",
    "input": "^1.0.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "node-telegram-bot-api": "^0.67.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2",
    "telegram": "^2.26.22",
    "zod": "^4.4.3"
  },
  "overrides": {
    "form-data": ">=2.5.4",
    "qs": ">=6.15.2",
    "tough-cookie": ">=4.1.3",
    "proxy-addr": ">=2.0.8",
    "@fastify/busboy": ">=3.2.2",
    "@grpc/grpc-js": ">=1.14.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hono/node-server": "^2.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "hono": "^4.13.7",
    "pg": "^8.23.0",
    "playwright": "^1.61.0",
    "satori": "^0.26.0",
    "vite": "^7.3.1",
    "wrangler": "^4.130.0"
  }
}