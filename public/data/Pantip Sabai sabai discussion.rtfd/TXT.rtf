\cb4 \uc0\u3614 \u3629 \u3648 \u3586 \u3657 \u3634 \u3617 \u3634 \u3651 \u3609 \u3627 \u3657 \u3629 \u3591  \u3611 \u3585 \u3605 \u3636 \u3592 \u3632 \u3648 \u3611 \u3655 \u3609 \u3608 \u3619 \u3619 \u3617 \u3648 \u3609 \u3637 \u3618 \u3617 \u3586 \u3629 \u3591 \u3619 \u3657 \u3634 \u3609 \u3609 \u3623 \u3604 \u3626 \u3611 \u3634 \u3629 \u3650 \u3619 \u3617 \u3656 \u3634 \u3585 \u3655 \u3588 \u3639 \u3629  \u3627 \u3617 \u3629 \u3592 \u3632 \u3605 \u3657 \u3629 \u3591 \u3586 \u3629 \u3605 \u3633 \u3623 \u3626 \u3633 \u3585 \u3614 \u3633 \u3585  (\u3609 \u3656 \u3634 \u3592 \u3632 \u3652 \u3611 \u3648 \u3605 \u3619 \u3637 \u3618 \u3617 \u3629 \u3640 \u3611 \u3585 \u3619 \u3603 \u3660 \u3649 \u3621 \u3632 \u3619 \u3629 \u3648 \u3619 \u3634 \u3629 \u3634 \u3610 \u3609 \u3657 \u3635 \u3592 \u3609 \u3648 \u3626 \u3619 \u3655 \u3592  \u3649 \u3621 \u3657 \u3623 \u3648 \u3619 \u3634 \u3592 \u3632 \u3609 \u3629 \u3609 \u3619 \u3629 \u3629 \u3618 \u3641 \u3656 \u3610 \u3609 \u3648 \u3605 \u3637 \u3618 \u3591 \u3609 \u3623 \u3604 ) \u3649 \u3605 \u3656 \u3627 \u3617 \u3629 \u3610 \u3629 \u3585 \u3623 \u3656 \u3634 \u3652 \u3627 \u3609 \u3654 \u3585 \u3655 \u3588 \u3640 \u3618 \u3585 \u3633 \u3609 \u3606 \u3641 \u3585 \u3588 \u3629 \u3605 \u3633 \u3657 \u3591 \u3649 \u3605 \u3656 \u3588 \u3619 \u3633 \u3657 \u3591 \u3649 \u3619 \u3585 \u3607 \u3637 \u3656 \u3648 \u3592 \u3629  \u3648 \u3621 \u3618 \u3610 \u3629 \u3585 \u3623 \u3656 \u3634 \u3592 \u3632 \u3651 \u3627 \u3657 \u3629 \u3634 \u3610 \u3609 \u3657 \u3635 \u3604 \u3657 \u3623 \u3618 \u3617 \u3633 \u3657 \u3618  \u3612 \u3617 \u3607 \u3637 \u3656 \u3614 \u3618 \u3634 \u3618 \u3634 \u3617 \u3648 \u3585 \u3655 \u3610 \u3629 \u3634 \u3619 \u3617 \u3603 \u3660 \u3627 \u3639 \u3656 \u3609 \u3629 \u3618 \u3641 \u3656 \u3614 \u3629 \u3652 \u3604 \u3657 \u3618 \u3636 \u3609 \u3604 \u3633 \u3591 \u3609 \u3633 \u3657 \u3609 \u3606 \u3638 \u3591 \u3585 \u3633 \u3610 \u3627 \u3641 \u3612 \u3638 \u3591  \u3619 \u3637 \u3610 \u3610 